{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile data",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID"
        },
        "displayName": {
          "type": "string",
          "description": "User's display name"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User's email address"
        },
        "photoURL": {
          "type": "string",
          "description": "URL to user's profile photo"
        },
        "role": {
          "type": "string",
          "enum": ["admin", "user", "player", "coach"],
          "description": "User's role in the system"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of account creation"
        },
        "lastLogin": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of last login"
        },
        "streakCount": {
          "type": "integer",
          "description": "Current daily login streak"
        },
        "totalScales": {
          "type": "integer",
          "description": "Total dragon scales collected"
        },
        "specialScales": {
          "type": "integer",
          "description": "Total special dragon scales collected (awarded every 7 days)"
        },
        "xp": {
          "type": "integer",
          "description": "Experience points earned by the user"
        },
        "level": {
          "type": "integer",
          "description": "User's current level"
        },
        "achievements": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of achievement IDs earned"
        },
        "lastStreakUpdate": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of the last streak update"
        },
        "dailyTriviaGames": {
          "type": "integer",
          "description": "Number of trivia games played today"
        },
        "lastTriviaDate": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of the last trivia game played"
        },
        "weeklyTriviaWins": {
          "type": "integer",
          "description": "Number of trivia games won this week"
        },
        "lastWeeklyReset": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of the last weekly reset for quests"
        },
        "ownedFrames": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of frame IDs owned by the user"
        },
        "activeFrame": {
          "type": "string",
          "description": "ID of the currently active profile frame"
        }
      },
      "required": ["uid", "email", "role", "createdAt", "lastLogin", "streakCount", "totalScales", "specialScales"]
    },
    "Subscriber": {
      "title": "Newsletter Subscriber",
      "description": "User subscribed to the newsletter",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "Subscriber email address"
        },
        "subscribedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of subscription"
        }
      },
      "required": ["email", "subscribedAt"]
    },
    "JoinRequest": {
      "title": "Join Request",
      "description": "User request to join the club",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Full name of the applicant"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Email address"
        },
        "phone": {
          "type": "string",
          "description": "Phone number"
        },
        "category": {
          "type": "string",
          "description": "Basketball category (e.g., Senior, Junior)"
        },
        "message": {
          "type": "string",
          "description": "Optional message"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "reviewed", "accepted", "rejected"],
          "description": "Current status of the request"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of request"
        }
      },
      "required": ["name", "email", "phone", "category", "status", "createdAt"]
    },
    "Notification": {
      "title": "User Notification",
      "description": "A notification sent to a user",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "UID of the recipient" },
        "title": { "type": "string", "description": "Notification title" },
        "message": { "type": "string", "description": "Notification message" },
        "type": { "type": "string", "enum": ["info", "success", "warning", "error"], "description": "Type of notification" },
        "read": { "type": "boolean", "description": "Whether the notification has been read" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp of creation" }
      },
      "required": ["userId", "title", "message", "type", "read", "createdAt"]
    },
    "PublicProfile": {
      "title": "Public User Profile",
      "description": "Publicly accessible user profile data (no PII)",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "fullName": { "type": "string" },
        "photoURL": { "type": "string" },
        "category": { "type": "string" },
        "position": { "type": "string" },
        "height": { "type": "string" },
        "weight": { "type": "string" },
        "birthDate": { "type": "string" },
        "jerseyNumber": { "type": "string" },
        "isVerifiedPlayer": { "type": "boolean" },
        "teamCode": { "type": "string" }
      },
      "required": ["uid", "displayName", "isVerifiedPlayer"]
    }
  },
  "firestore": {
    "users": {
      "schema": "User",
      "description": "Collection of user profiles"
    },
    "public_profiles": {
      "schema": "PublicProfile",
      "description": "Collection of public user profiles"
    },
    "subscribers": {
      "schema": "Subscriber",
      "description": "Collection of newsletter subscribers"
    },
    "join_requests": {
      "schema": "JoinRequest",
      "description": "Collection of club join requests"
    },
    "notifications": {
      "schema": "Notification",
      "description": "Collection of user notifications"
    }
  }
}
