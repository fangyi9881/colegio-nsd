{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "colegionsdolores.es"
        }
      ],
      "destination": "https://www.colegionsdolores.es/:path*",
      "permanent": true
    },
    {
      "source": "/secretaria-virtual",
      "destination": "/familias",
      "permanent": true
    },
    {
      "source": "/etapas/infantil-0-3",
